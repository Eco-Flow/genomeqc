nextflow_process {

    name "Test Process BUSCO_SEQS"
    script "../main.nf"
    process "BUSCO_SEQS"

    tag "modules"
    tag "modules_local"
    tag "buscos_seqs"

    test("buscos_seqs - single table") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("\${baseDir}/modules/local/buscos_seqs/tests/test_species.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("buscos_seqs - single table - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("\${baseDir}/modules/local/buscos_seqs/tests/test_species.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
