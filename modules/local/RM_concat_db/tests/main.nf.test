nextflow_process {

    name "Test Process RM_CONCAT_DB"
    script "../main.nf"
    process "RM_CONCAT_DB"

    tag "modules"
    tag "modules_local"
    tag "rm_concat_db"

    test("rm_concat_db - two lineage databases - currently fails") {

        // KNOWN BUG: h5copy only accepts a single file after -i, but this
        // module joins all input files into one space-separated -i argument
        // (`h5copy -i ${sorted_files} -o dfam_full.h5 -s ./ -d ./`), which is
        // not valid h5copy usage for more than one file. Verified directly
        // against h5copy: it fails immediately with "Output file name
        // missing" whenever more than one input file is given, which is the
        // module's entire stated purpose (merging multiple per-lineage
        // databases). This test documents that current, broken behavior
        // rather than working around it — it should be rewritten once the
        // module is fixed to loop h5copy once per file against a real
        // object path (the current `-s ./ -d ./` is also invalid HDF5
        // object-path syntax; h5copy works fine given e.g. `-s /Families
        // -d /Families -p`).

        when {
            process {
                """
                input[0] = [
                    file("\${baseDir}/modules/local/RM_concat_db/tests/lineageA.h5", checkIfExists: true),
                    file("\${baseDir}/modules/local/RM_concat_db/tests/lineageB.h5", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('Output file name missing') }
            )
        }
    }
}
