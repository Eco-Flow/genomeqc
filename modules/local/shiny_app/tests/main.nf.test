nextflow_process {

    name "Test Process SHINY_APP"
    script "../main.nf"
    process "SHINY_APP"

    tag "modules"
    tag "modules_local"
    tag "shiny_app"

    test("shiny_app - tables and tree") {

        when {
            params {
                outdir = "results"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/shiny_app/tests/test.tsv", checkIfExists: true) ],
                    file("\${baseDir}/modules/local/shiny_app/tests/tree.nw", checkIfExists: true)
                ]
                input[1] = file("\${baseDir}/bin/tree_functions.R", checkIfExists: true)
                input[2] = file("\${baseDir}/bin/shiny_app.R", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("shiny_app - tables and tree - stub") {

        options "-stub"

        when {
            params {
                outdir = "results"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/shiny_app/tests/test.tsv", checkIfExists: true) ],
                    file("\${baseDir}/modules/local/shiny_app/tests/tree.nw", checkIfExists: true)
                ]
                input[1] = file("\${baseDir}/bin/tree_functions.R", checkIfExists: true)
                input[2] = file("\${baseDir}/bin/shiny_app.R", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
