nextflow_process {

    name "Test Process ORTHOLOGOUS_CHROMOSOMES"
    script "../main.nf"
    process "ORTHOLOGOUS_CHROMOSOMES"

    tag "modules"
    tag "modules_local"
    tag "orthologous_chromosomes"

    test("orthologous_chromosomes - two species") {

        when {
            process {
                """
                input[0] = file("\${baseDir}/modules/local/orthologous_chromosomes/tests/orthogroups.tsv", checkIfExists: true)
                input[1] = [
                    file("\${baseDir}/modules/local/orthologous_chromosomes/tests/speciesA.gff", checkIfExists: true),
                    file("\${baseDir}/modules/local/orthologous_chromosomes/tests/speciesB.gff", checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Row order in the pairwise/species outputs depends on Python set
            // iteration order, which varies between runs (hash randomization),
            // so lines are sorted before snapshotting to keep this deterministic.
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.species_summary[0]).readLines().sort(),
                    path(process.out.pairwise_summary[0]).readLines().sort()
                    ).match() }
            )
        }
    }

    test("orthologous_chromosomes - two species - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("\${baseDir}/modules/local/orthologous_chromosomes/tests/orthogroups.tsv", checkIfExists: true)
                input[1] = [
                    file("\${baseDir}/modules/local/orthologous_chromosomes/tests/speciesA.gff", checkIfExists: true),
                    file("\${baseDir}/modules/local/orthologous_chromosomes/tests/speciesB.gff", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
