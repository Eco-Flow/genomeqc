nextflow_process {

    name "Test Process CREATEPATH"
    script "../main.nf"
    process "CREATEPATH"

    tag "modules"
    tag "modules_local"
    tag "createpath"

    test("createpath - accession") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', ncbi:'refseq' ], // meta map
                    'GCF_000027325.1'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("createpath - accession - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', ncbi:'refseq' ], // meta map
                    'GCF_000027325.1'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
