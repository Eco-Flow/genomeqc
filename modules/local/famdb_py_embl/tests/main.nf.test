nextflow_process {

    name "Test Process FAMDB_PY_EMBL"
    script "../main.nf"
    process "FAMDB_PY_EMBL"

    tag "modules"
    tag "modules_local"
    tag "famdb_py_embl"

    // test.0.h5 is synthetic, built by build_test_famdb.py (see that file to regenerate).
    test("famdb_py_embl - descendants of test taxon") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdb_py_embl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("famdb_py_embl - descendants of test taxon - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdb_py_embl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
