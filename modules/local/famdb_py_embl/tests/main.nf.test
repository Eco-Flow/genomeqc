nextflow_process {

    name "Test Process FAMDB_PY_EMBL"
    script "../main.nf"
    process "FAMDB_PY_EMBL"

    tag "modules"
    tag "modules_local"
    tag "famdb_py_embl"

    // test.0.h5 is a tiny synthetic famdb database (not a real Dfam export)
    // built by build_test_famdb.py against famdb.py's own internal classes,
    // matching the famdb format version (2.0.5) bundled with this module's
    // pinned RepeatMasker container. See that script's header for details
    // and how to regenerate it if the container's famdb.py is ever upgraded.
    test("famdb_py_embl - descendants of test taxon") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdb_py_embl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("famdb_py_embl - descendants of test taxon - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdb_py_embl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
