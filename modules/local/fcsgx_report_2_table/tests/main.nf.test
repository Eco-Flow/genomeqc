nextflow_process {

    name "Test Process FCSGX_REPORT_2_TABLE"
    script "../main.nf"
    process "FCSGX_REPORT_2_TABLE"

    tag "modules"
    tag "modules_local"
    tag "fcsgx_report_2_table"

    test("fcsgx_report_2_table - two reports, one clean") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/fcsgx_report_2_table/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/fcsgx_report_2_table/tests/speciesB.fcs_gx_report.txt", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("fcsgx_report_2_table - two reports, one clean - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/fcsgx_report_2_table/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/fcsgx_report_2_table/tests/speciesB.fcs_gx_report.txt", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
