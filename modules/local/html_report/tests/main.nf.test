nextflow_process {

    name "Test Process HTML_REPORT"
    script "../main.nf"
    process "HTML_REPORT"

    tag "modules"
    tag "modules_local"
    tag "html_report"

    test("html_report - no optional inputs") {

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                input[10] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.report[0]).exists() },
                { assert snapshot(process.out.versions_python).match() }
            )
        }
    }

    test("html_report - no optional inputs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                input[10] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
