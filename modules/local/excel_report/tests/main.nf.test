nextflow_process {

    name "Test Process EXCEL_REPORT"
    script "../main.nf"
    process "EXCEL_REPORT"

    tag "modules"
    tag "modules_local"
    tag "excel_report"

    test("excel_report - no optional inputs") {

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.excel[0]).exists() },
                { assert snapshot(process.out.versions_python).match() }
            )
        }
    }

    test("excel_report - no optional inputs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
