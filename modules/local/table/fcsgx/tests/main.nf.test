nextflow_process {

    name "Test Process TABLE_FCSGX"
    script "../main.nf"
    process "TABLE_FCSGX"

    tag "modules"
    tag "modules_local"
    tag "table"
    tag "table/fcsgx"

    test("table_fcsgx - three reports, one clean") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesC.fcs_gx_report.txt", checkIfExists: true)
                    ],
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fasta", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fasta", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesC.fasta", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            // speciesA: 2 x 1 kb EXCLUDE in a 20 kb genome -> 10%
            // speciesB: empty report -> 0%
            // speciesC: TRIM 500 + overlapping FIX ranges merged to 600 + EXCLUDE 1000
            //           (REVIEW and INFO rows ignored) in a 10 kb genome -> 21%
            def rows = path(process.out.table[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert rows[0] == "species\tcontaminant_pct\tnon_contaminant_pct\tcontaminant_bp\tgenome_bp" },
                { assert rows.contains("speciesA\t10.0\t90.0\t2000\t20000") },
                { assert rows.contains("speciesB\t0.0\t100.0\t0\t5000") },
                { assert rows.contains("speciesC\t21.0\t79.0\t2100\t10000") },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("table_fcsgx - three reports, one clean - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesC.fcs_gx_report.txt", checkIfExists: true)
                    ],
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fasta", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fasta", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesC.fasta", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
